# Server & Environment
PORT=3000
NODE_ENV=development

# JWT Authentication (generate a secure 32+ character random string in production)
JWT_SECRET=development-fallback-secret-at-least-32-chars-long

# Gemini AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Configuration (Optional - for persistent cloud Firestore sync)
FIREBASE_PROJECT_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
